# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
API_KEY=

CORS_ORIGINS=["http://localhost:5173"]

# --- Local Therapy LLM (OpenAI-compatible, e.g. vLLM / services/local-llm) ---
# LOCAL_LLM_PROVIDER=mock uses a canned in-process response so the API is
# usable end-to-end with no model server running. Switch to "http" once a
# real OpenAI-compatible server is up.
LOCAL_LLM_PROVIDER=mock
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=local-therapy-llm

# --- Frontier LLM (optional, e.g. GPT/Claude/Gemini via an OpenAI-compatible gateway) ---
FRONTIER_LLM_ENABLED=false
FRONTIER_LLM_BASE_URL=https://api.openai.com/v1
FRONTIER_LLM_API_KEY=
FRONTIER_LLM_MODEL=gpt-4o-mini

# --- Embeddings (used for RAG + patient memory) ---
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

RAG_TOP_K=8
RERANK_TOP_K=4

# --- Database (own Postgres + pgvector, separate from the Supabase project) ---
DATABASE_URL=postgresql+asyncpg://therapilot:therapilot@localhost:5433/therapilot_backend
