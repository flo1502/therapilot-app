# Copy to .env and fill in real values. Never commit .env.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# OpenAI-compatible local inference endpoint (e.g. Ollama). Defaults match
# a stock local Ollama install if left unset.
VITE_LOCAL_LLM_URL=http://localhost:11434/v1
VITE_LOCAL_LLM_MODEL=psyco

